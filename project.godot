; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SubterraIndustires"
run/main_scene="res://hud/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=120

[autoload]

Enums="*res://custom_types/enums.gd"
Globals="*res://custom_types/globals.gd"
GF="*res://custom_types/global_methods.gd"
GameManager="*res://systems/game_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/collapse_folders/plugin.cfg", "res://addons/grid_building/plugin.cfg", "res://addons/post_processing/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/shaker/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="uid://bqnstwubygps6"

